# Copia questo file in .env.docker e compila le tre password prima dell'avvio.
# SSO Keycloak opzionale: vedi .env.keycloak.example e docs/tehnical/keycloak.md.
# Lo script configure_keycloak.py genera data/keycloak/compose.env per l'overlay.
# Prepara i certificati: python3 scripts/configure_network.py prepare
# Primo avvio: python3 scripts/manage_cluster.py --env-file .env.docker init
# init prepara anche cluster-recovery per i successivi riavvii automatici sicuri.
# Deployment esistente sano: python3 scripts/manage_cluster.py --env-file .env.docker enable-autorecovery
# Conserva --tickets / --keycloak / --keycloak-groups se gia usati dal deployment.
# Recupero manuale, se necessario: python3 scripts/manage_cluster.py --env-file .env.docker recover
# Le password vuote vengono rifiutate da Compose.
# L'app e raggiungibile solo tramite Nginx, sulla NPM_HTTP_PORT.
PUNTO_EMAIL=admin@example.test
PUNTO_PASSWORD=

# Origini pubbliche autorizzate, separate da virgole e senza slash finale.
# Aggiungi qui il dominio configurato in Nginx Proxy Manager, ad esempio
# PUBLIC_ORIGINS=http://localhost,http://127.0.0.1,https://punto.example.com
PUBLIC_ORIGINS=http://localhost,http://127.0.0.1,http://progetti.tuaazienda.it,https://progetti.tuaazienda.it

# Nginx Proxy Manager: porte HTTP/HTTPS pubbliche; pannello admin solo locale.
NPM_HTTP_PORT=80
NPM_HTTPS_PORT=443
NPM_ADMIN_PORT=81
NPM_TZ=Australia/Brisbane
# Credenziali del pannello NPM, lette solo dallo script configure_proxy.py.
# Compila NPM_ADMIN_PASSWORD con una password dedicata (8-64 caratteri).
NPM_ADMIN_EMAIL=admin@punto.local
NPM_ADMIN_PASSWORD=

MYSQL_DATABASE=punto
MYSQL_USER=punto
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Cluster MySQL: init genera queste password nel file reale se sono vuote.
# La password di replica può contenere al massimo 32 byte.
# Non cambiarle dopo l'inizializzazione senza ruotare anche gli account MySQL.
CLUSTER_REPLICATION_PASSWORD=
CLUSTER_MONITOR_PASSWORD=

# Il controller automatico NON usa MYSQL_ROOT_PASSWORD e non ha socket Docker.
# enable-autorecovery/init generano il segreto in data/cluster-recovery/password
# e le identita attese in data/cluster-recovery/cluster.json (sola lettura).
# Nessuna password aggiuntiva va inserita qui; non modificare UUID o file segreti
# per aggirare un blocco del recupero. NON eliminare cluster_recovery_data:
# il registro persistente conserva anche i marcatori di bootstrap interrotto.
# In caso di rifiuto consulta i log di cluster-recovery e manage_cluster.py status.
# enable-autorecovery verifica anche autenticazione e TLS prima del successo.
# Prima di STOP GROUP_REPLICATION manuale via SQL su tutti i nodi, ferma
# cluster-recovery; riavvialo a fine manutenzione. manage_cluster.py e
# configure_network.py apply usano gia flock host (data/cluster-host.lock)
# + helper Linux su data/cluster-controller.lock, file distinto
# (network=none, solo mount del lock, nessun segreto/socket Docker).

# Archivio PDF MongoDB: init genera password distinte se lasciate vuote.
# Non cambiare queste password dopo l'inizializzazione nel solo file env.
DOC_DB_NAME=punto_documents
DOC_DB_USER=punto_documents
DOC_DB_PASSWORD=
DOC_DB_ROOT_PASSWORD=

# Addon email: lascia HOST/FROM/USER vuoti fino alla configurazione SMTP.
# Password in data/addon-secrets/smtp-password, mai in questo file.
# prepare genera il token API dedicato senza stamparlo e conserva gli esistenti.
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_MODE=starttls
MAIL_SMTP_FROM=
MAIL_SMTP_USER=
# Mantieni il namespace insieme al database applicativo e al registro addon.
MAIL_API_NAMESPACE=punto-alerts-v1

# Addon Google Calendar: lascia ID/REDIRECT vuoti fino alla configurazione OAuth.
# Client secret in data/addon-secrets/google-client-secret, mai in questo file.
# La redirect URI pubblica deve coincidere con quella autorizzata in Google Cloud:
# https://<dominio-app>/api/calendar/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_REDIRECT_URI=
CALENDAR_SYNC_INTERVAL=300

# Usa password diverse per l'account gestore, l'utente MySQL e root MySQL.
# PUNTO_EMAIL e PUNTO_PASSWORD creano solo il primo gestore su un database vuoto.
# Con un volume MySQL già inizializzato, cambiare queste variabili non modifica
# automaticamente gli account o le password già salvate.
