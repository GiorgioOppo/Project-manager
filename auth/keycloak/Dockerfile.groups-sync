FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 punto-groups \
    && useradd --uid 10001 --gid 10001 --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin punto-groups
WORKDIR /app
COPY auth/keycloak/sync_groups.py /app/sync_groups.py
USER 10001:10001
ENTRYPOINT ["python3", "/app/sync_groups.py"]
