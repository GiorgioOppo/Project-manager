# Esporta queste variabili nella shell prima di eseguire make run.
# Il server non carica automaticamente file .env.
PORT=8080
BIND_HOST=127.0.0.1
# PUBLIC_PORT può differire da PORT dietro una mappatura Docker.
PUBLIC_PORT=8080
# Usate solo per creare il primo gestore su un database senza utenti.
PUNTO_EMAIL=demo@punto.local
PUNTO_PASSWORD=Punto2026!
PUBLIC_DIR=public
DB_PATH=data/punto.db
# Autenticazione: local (predefinita), hybrid, oidc.
# Per SSO configurare anche OIDC_* secondo docs/tehnical/keycloak.md.
AUTH_MODE=local
# keycloak centralizza utenti/ruoli; in hybrid richiede l'email di emergenza.
AUTH_USER_MANAGEMENT=local
# AUTH_LOCAL_ADMIN_EMAIL=admin@example.test
# OIDC_ROLE_CLAIM=app_roles
# OIDC_ADMIN_ROLE=manager
# OIDC_USER_ROLE=worker
# OIDC_USERS_ADMIN_URL=https://auth.example.test/admin/punto/console/
# OIDC_ISSUER_URL=https://auth.example.test/realms/punto
# OIDC_BACKCHANNEL_URL=https://keycloak:8443/realms/punto
# OIDC_CLIENT_ID=punto
# OIDC_CLIENT_SECRET_FILE=/percorso/progetto/data/keycloak/secrets/punto-client-secret
# OIDC_REDIRECT_URI=https://punto.example.test/auth/callback
# OIDC_BINDINGS_FILE=/percorso/progetto/data/keycloak/bindings/punto.json
# OIDC_CA_FILE=/percorso/progetto/data/keycloak/tls/ca.crt
