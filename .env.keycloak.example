# Documento di riferimento: init genera data/keycloak/compose.env senza segreti.
# python3 scripts/configure_keycloak.py init \
#   --issuer https://auth.example.test/realms/punto \
#   --punto-origin https://punto.example.test \
#   --tickets-origin https://tickets.example.test
# Caricare dopo .env.docker e (se usato) ticket-app/.env.
KEYCLOAK_PUBLIC_ORIGIN=https://auth.example.test
KEYCLOAK_BOOTSTRAP_ADMIN=punto-bootstrap
KEYCLOAK_ISSUER_URL=https://auth.example.test/realms/punto
KEYCLOAK_PUNTO_REDIRECT_URI=https://punto.example.test/auth/callback
KEYCLOAK_TICKETS_REDIRECT_URI=https://tickets.example.test/auth/callback
# hybrid conserva l'accesso locale durante l'associazione degli account.
# Passare a oidc dopo la verifica dei binding; senza overlay il default è local.
KEYCLOAK_AUTH_MODE=hybrid
KEYCLOAK_TICKETS_AUTH_MODE=hybrid
# Dopo la migrazione esplicita abilita utenti e ruoli centralizzati.
KEYCLOAK_USER_MANAGEMENT=local
# Richiesto in hybrid con gestione keycloak: unico account locale di emergenza.
KEYCLOAK_LOCAL_ADMIN_EMAIL=
KEYCLOAK_USERS_ADMIN_URL=https://auth.example.test/admin/punto/console/
# Password bootstrap, database e client sono file 0600 in data/keycloak/secrets.
