# Account iniziale indipendente da Punto; password di almeno 12 caratteri.
# Le credenziali creano il primo gestore soltanto su un archivio vuoto.
TICKETS_EMAIL=gestore@example.test
TICKETS_PASSWORD=
TICKETS_NAME=Gestore

# Origine esatta del browser, senza slash finale.
# Se cambi la porta pubblicata, aggiorna anche questa origine.
TICKETS_PUBLIC_ORIGIN=http://localhost:8083
# Fino a tre origini aggiuntive esatte, separate da virgole e senza spazi.
# Esempio: https://ticket.tuaazienda.it (DNS e certificato HTTPS necessari).
TICKETS_ADDITIONAL_ORIGINS=
TICKETS_HOST_PORT=8083

# Collegamento ai cataloghi di Punto (origine esatta, senza slash finale).
# Produzione: https://punto.tuaazienda.it. Lasciare vuoto per uso autonomo.
TICKETS_PUNTO_ORIGIN=
# Con compose.tickets.yaml: 172.30.20.2 (NPM sulla rete privata).
# Usare solo insieme a un'origine HTTPS; conserva la verifica del certificato.
TICKETS_PUNTO_RESOLVE_IP=
# Nativo, facoltativo: CA privata. Con certificati pubblici usa le CA di sistema.
# TICKETS_PUNTO_CA_FILE=/percorso/ca.pem

# Tag comune per le immagini Docker compilate dal progetto.
PUNTO_IMAGE_TAG=local

# Ricezione email opzionale: caselle e mittenti si configurano nella sezione RAW.
# La directory deve esistere, essere accessibile al solo amministratore e
# contenere i file credenziali indicati da secret_name, leggibili da UID 10006.
# Non inserire password o token in questo file. Abilitare l'overlay inbound
# soltanto quando si desidera avviare il ricevitore separato.
# TICKETS_IMAP_SECRETS_PATH=/percorso/assoluto/credenziali-ticket
TICKETS_IMAP_POLL_SECONDS=30
# Nativo: TICKETS_IMAP_SECRET_DIR=/percorso/assoluto/credenziali-ticket
# Nativo, facoltativo: TICKETS_IMAP_CA_FILE=/percorso/ca-imap.pem

# Accesso: local (predefinito), hybrid (locale + Keycloak), oidc (solo Keycloak).
# Le identità Keycloak devono essere associate esplicitamente ad account Ticket
# locali attivi; ruoli e dati restano nell'archivio Ticket.
# Gli overlay Docker usano KEYCLOAK_* generati da configure_keycloak.py.
# Per l'avvio nativo esportare OIDC_* con percorsi assoluti dell'host;
# i percorsi /run/punto-auth qui sotto sono quelli degli overlay Docker.
AUTH_MODE=local
# keycloak centralizza utenti/ruoli; in hybrid richiede l'email di emergenza.
AUTH_USER_MANAGEMENT=local
# AUTH_LOCAL_ADMIN_EMAIL=admin@example.test
# OIDC_ROLE_CLAIM=app_roles
# OIDC_ADMIN_ROLE=admin
# OIDC_USER_ROLE=agent
# OIDC_USERS_ADMIN_URL=https://auth.example.it/admin/punto/console/
# OIDC_ISSUER_URL=https://auth.example.it/realms/punto
# OIDC_BACKCHANNEL_URL=https://keycloak:8443/realms/punto
# OIDC_CLIENT_ID=punto-tickets
# OIDC_CLIENT_SECRET_FILE=/run/punto-auth/client-secret
# OIDC_REDIRECT_URI=https://ticket.example.it/auth/callback
# OIDC_BINDINGS_FILE=/run/punto-auth/bindings.json
# OIDC_CA_FILE=/run/punto-auth/ca.crt
# Solo per prove esplicite su HTTP; in produzione mantenere disabilitato.
OIDC_ALLOW_HTTP=0
