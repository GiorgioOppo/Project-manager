# Account iniziale indipendente da Punto; password di almeno 12 caratteri.
# Le credenziali creano il primo gestore soltanto su un archivio vuoto.
TICKETS_EMAIL=gestore@example.test
TICKETS_PASSWORD=
TICKETS_NAME=Gestore

# Origine esatta del browser, senza slash finale.
# Se cambi la porta pubblicata, aggiorna anche questa origine.
TICKETS_PUBLIC_ORIGIN=http://localhost:8083
TICKETS_HOST_PORT=8083

# Tag comune per le immagini Docker compilate dal progetto.
PUNTO_IMAGE_TAG=local
